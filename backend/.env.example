# Local Docker Compose values only. Replace SECRET_KEY before any deployment.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/students_clubs
SECRET_KEY=replace-this-development-secret
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=students-clubs-files
S3_REGION=us-east-1
EXTERNAL_WEATHER_API_KEY=
